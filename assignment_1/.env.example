# ==============================================================
# EDXSO Influencer Outreach AI (InfluenceFlow AI) - Environment Config
# ==============================================================

# Core System Ports
PORT_GATEWAY=5000
PORT_AI_SERVICE=8000
PORT_WEB=3000

# Node.js API Gateway Config
NODE_ENV=development
API_GATEWAY_URL=http://localhost:5000
AI_SERVICE_URL=http://localhost:8000
WEB_URL=http://localhost:3000
JWT_SECRET=super-secret-jwt-key-edxso-2026-production

# AI Engine / LLM Configuration
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_MAX_RETRIES=3

# Outreach & Email Configuration
DRY_RUN=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=outreach@edxso-demo.ai
SMTP_PASS=app-password-placeholder
SENDER_NAME="EDXSO Influencer Partnerships"
SENDER_EMAIL=partnerships@edxso-demo.ai

# Database & Storage
DATA_STORAGE_MODE=embedded_json_sqlite
DATABASE_URL=sqlite:///./data/edxso_campaigns.db
